# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# IDEs and Editors
.idea/                  # JetBrains IDEs (PyCharm, IntelliJ)
.vscode/                # VS Code (except settings.json if shared)
*.sublime-project       # Sublime Text
*.sublime-workspace
.DS_Store               # macOS
Thumbs.db               # Windows

# Data and Artifacts (Crucial for this project)
# Raw data collected from APIs (should be in data lake, not Git)
/data/raw/
/data/processed/
/data/labeled/
/data/output/

# Trained ML Models
/models/                # Directory for trained models
*.pt                    # PyTorch models
*.pth                   # PyTorch models
*.h5                    # Keras/TensorFlow models
*.keras                 # Keras 3 models
*.pkl                   # Pickle files (often used for models/data)
*.joblib                # Joblib files (often used for models/data)
*.onnx                  # ONNX models
*.tflite                # TensorFlow Lite models
*.pb                    # TensorFlow SavedModel protocol buffers

# ML Experiment Logs and Checkpoints
/logs/                  # General log directory
/runs/                  # TensorBoard logs (e.g., from PyTorch Lightning, Keras)
/checkpoints/           # Model checkpoints during training
/results/               # Experiment results, plots, reports

# Configuration and Secrets
.env                    # Environment variables (e.g., API keys, database credentials)
config_local.py         # Local-specific configuration that shouldn't be committed
*.key                   # Private keys
*.pem                   # Certificates
*.envrc                 # direnv files

# Jupyter Notebooks (if applicable)
.ipynb_checkpoints/     # Jupyter Notebook checkpoints

# Project-specific temporary files
*.tmp
*.bak
*.swp

# Operating System Files
.Trash-* # macOS Trash
*.log                   # Any log files generated by the application
